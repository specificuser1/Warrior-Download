<!DOCTYPE html>
<html lang="en">
<head>
  <title>Admin Login</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-box animate">
    <h2 style="color:var(--red); margin-bottom:1rem;">🔐 Admin Access</h2>
    <% if (locals.error) { %><p class="error"><%= error %></p><% } %>
    <form method="POST" action="/admin/login">
      <input type="password" name="password" placeholder="Admin Password" required>
      <button class="btn" type="submit">Login</button>
    </form>
    <p style="margin-top:1rem; text-align:center; color:#555;">Default: <code>admin123</code></p>
  </div>
</body>
</html>
