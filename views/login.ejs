<!DOCTYPE html>
<html lang="en">
<head>
  <title>Only For Developer</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrapper">
    <div class="auth-box">
      <h2 style="margin-bottom:1.5rem;">Developer Access</h2>
      <% if (locals.error) { %><div class="alert"><%= error %></div><% } %>
      <form method="POST" action="/admin/login">
        <input type="password" name="password" class="input" placeholder="Enter Secret" required style="margin-bottom:1rem;">
        <button class="btn" type="submit" style="width:100%;">Get Access</button>
      </form>
      <p class="text-muted" style="margin-top:1rem;">PROGRAMMED BY <code style="color:var(--primary);">SUBHAN</code></p>
    </div>
  </div>
</body>
</html>
