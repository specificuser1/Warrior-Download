<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= site_title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="container header-inner">
      <a href="/" class="logo">
        <% if (logo) { %><img src="<%= logo %>" alt="Logo"><% } %>
        <span><%= site_title %></span>
      </a>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>Advanced Tools. Direct Access.</h1>
      <p class="text-muted">Curated, tested, and secure downloads. No redirects. No ads.</p>
      <div class="search-box">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input type="text" id="searchInput" class="input" placeholder="Search tools...">
      </div>
    </section>

    <div class="tools-grid" id="toolsGrid">
      <% tools.forEach(tool => { %>
        <div class="tool-card" data-name="<%= tool.name.toLowerCase() %>">
          <img src="<%= tool.thumb %>" alt="<%= tool.name %>" class="thumb" onerror="this.src='/placeholder.png'">
          <div class="card-body">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
              <h3 class="card-title" style="margin:0;"><%= tool.name %></h3>
              <span class="download-count"><i class="fa-solid fa-circle-arrow-down"></i> <%= tool.downloads %> <%= download_label %></span>
            </div>
            <p class="card-desc"><%= tool.desc %></p>
            <div class="card-actions">
              <button class="btn download-btn" style="flex:1;" data-value="<%= tool.download_value %>" data-status="<%= tool.status %>">
                <%= tool.status === 'updating' ? 'Under Updating' : 'Download' %>
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <footer>
    <div class="container footer-inner">
      <div class="socials">
        <% socials.forEach(s => { %>
          <a href="<%= s.link %>" target="_blank"><i class="fa-brands fa-<%= s.platform %>"></i></a>
        <% }) %>
      </div>
      <p class="copyright"><%= footer_text %></p>
      <p class="copyright">Developed by SUBHAN | &copy; 2026 <%= site_title %></p>
    </div>
  </footer>

  <div id="updateModal" class="modal hidden">
    <div class="modal-content">
      <h3>Tool is Under Updating...</h3>
      <p>This tool is currently being patched. Please check back later or join our Discord for ETA.</p>
      <button class="btn" onclick="closeModal()">Understood</button>
    </div>
  </div>

  <script>
    document.getElementById('searchInput').addEventListener('input', e => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll('.tool-card').forEach(c => c.style.display = c.dataset.name.includes(q) ? 'flex' : 'none';
    });

    document.querySelectorAll('.download-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        if (this.dataset.status === 'updating') {
          document.getElementById('updateModal').classList.remove('hidden');
        } else {
          window.open(this.dataset.value, '_blank');
        }
      });
    });

    function closeModal() { document.getElementById('updateModal').classList.add('hidden'); }
  </script>
</body>
</html>
